# CMS-Auto Production Environment Example
# Copy this to .env.production on the VPS and replace all placeholder values

SITE_DOMAIN=replace-with-domain.com
ACME_EMAIL=replace-with-ops-email@domain.com

POSTGRES_DB=cms_auto
POSTGRES_USER=cms_auto
POSTGRES_PASSWORD=replace-with-strong-db-password

REDIS_PASSWORD=replace-with-strong-redis-password

ATTACHMENT_S3_ENDPOINT=replace-with-s3-endpoint
ATTACHMENT_S3_REGION=replace-with-s3-region
ATTACHMENT_S3_BUCKET=replace-with-s3-bucket
ATTACHMENT_S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
ATTACHMENT_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
ATTACHMENT_S3_FORCE_PATH_STYLE=false
ATTACHMENT_DOWNLOAD_TTL_SECONDS=300

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_FROM=replace-with-smtp-sender-name <replace-with-smtp-sender-email@domain.com>
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SECURE=false

SLA_JOB_INTERVAL_MS=60000
NOTIFICATION_JOB_INTERVAL_MS=30000
