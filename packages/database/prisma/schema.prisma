  enableDueDateField     Boolean    @default(true) @map("enable_due_date_field")
  enableAttachmentsField Boolean    @default(true) @map("enable_attachments_field")
  enableOfficerSelection Boolean    @default(true) @map("enable_officer_selection")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  department             Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_ticket_form_configs")
}

model DepartmentTicketCustomField {
  id            String          @id @default(cuid())
  departmentId  String          @map("department_id")
  nameEn        String          @map("name_en")
  nameAr        String          @map("name_ar")
  fieldType     CustomFieldType @map("field_type")
  options       String[]        @default([])
  placeholderEn String?         @map("placeholder_en")
  placeholderAr String?         @map("placeholder_ar")
  isRequired    Boolean         @default(false) @map("is_required")
  isActive      Boolean         @default(true)  @map("is_active")
  order         Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt      @map("updated_at")

  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, isActive, order])
  @@map("department_ticket_custom_fields")
}

model UserTicketRule {
  id                            String   @id @default(cuid())
  userId                        String   @unique @map("user_id")
  canSendWithoutManagerApproval Boolean  @default(false) @map("can_send_without_manager_approval")
  canDirectAssignOfficer        Boolean  @default(true)  @map("can_direct_assign_officer")
  canSelfAssign                 Boolean  @default(true)  @map("can_self_assign")
  canTransferDepartment         Boolean  @default(true)  @map("can_transfer_department")
  canCloseDirectly              Boolean  @default(true)  @map("can_close_directly")
  canReopenTickets              Boolean  @default(true)  @map("can_reopen_tickets")
  createdAt                     DateTime @default(now())  @map("created_at")
  updatedAt                     DateTime @updatedAt      @map("updated_at")

  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ticket_rules")
}

// Models
model TicketCategory {
  id       String           @id @default(cuid())
  nameEn   String           @map("name_en")
  nameAr   String           @map("name_ar")
  isActive Boolean          @default(true) @map("is_active")

  @@map("ticket_categories")
}

model TicketWaitingReason {
  id           String           @id @default(cuid())
  departmentId String           @map("department_id")
  reasonEn     String           @map("reason_en")
  reasonAr     String           @map("reason_ar")
  order        Int              @default(0)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   Department       @relation(fields: [departmentId], references: [id])
  tickets      InternalTicket[]

  @@index([departmentId])
  @@map("ticket_waiting_reasons")
}

model TicketResolutionReason {
  id           String           @id @default(cuid())
  departmentId String           @map("department_id")
  reasonEn     String           @map("reason_en")
  reasonAr     String           @map("reason_ar")
  order        Int              @default(0)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   Department       @relation(fields: [departmentId], references: [id])
  tickets      InternalTicket[]

  @@index([departmentId])
  @@map("ticket_resolution_reasons")
}

model TicketRejectReason {
  id           String           @id @default(cuid())
  departmentId String           @map("department_id")
  reasonEn     String           @map("reason_en")
  reasonAr     String           @map("reason_ar")
  order        Int              @default(0)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   Department       @relation(fields: [departmentId], references: [id])
  tickets      InternalTicket[]

  @@index([departmentId])
  @@map("ticket_reject_reasons")
}

model TicketSlaOption {
  id              String  @id @default(cuid())
  nameEn          String  @map("name_en")
  nameAr          String  @map("name_ar")
  durationMinutes Int
  order           Int     @default(0)
  isActive        Boolean @default(true) @map("is_active")

  @@map("ticket_sla_options")
}

model InternalTicket {
  id              String @id @default(cuid())
  referenceNumber String @unique @map("reference_number")
  title           String
  description     String

  status   InternalTicketStatus   @default(NEW)
  priority InternalTicketPriority @default(NORMAL)

  requestedById       String  @map("requested_by_id")
  targetDepartmentId  String  @map("target_department_id")
  assignedEmployeeId  String? @map("assigned_employee_id")
  requestedEmployeeId String? @map("requested_employee_id")

  categoryId          String  @map("category_id")
  waitingReasonId     String? @map("waiting_reason_id")
  customWaitingReason String? @map("custom_waiting_reason")
  resolutionReasonId  String? @map("resolution_reason_id")
  resolutionDetails   String? @map("resolution_details")
  rejectReasonId      String? @map("reject_reason_id")
  rejectDetails       String? @map("reject_details")

  slaOptionId String?   @map("sla_option_id")
  dueAt       DateTime? @map("due_at")
  customFields Json?    @map("custom_fields")

  inProgressAt DateTime? @map("in_progress_at")
  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  requestedBy       User                    @relation("TicketRequestedBy", fields: [requestedById], references: [id])
  assignedEmployee  User?                   @relation("TicketAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  requestedEmployee User?                   @relation("TicketRequestedEmployee", fields: [requestedEmployeeId], references: [id])
  category          Category          @relation(fields: [categoryId], references: [id])
  targetDepartment  Department              @relation("InternalTicketTargetDepartment", fields: [targetDepartmentId], references: [id])
  waitingReason     TicketWaitingReason?    @relation(fields: [waitingReasonId], references: [id])
  resolutionReason  TicketResolutionReason? @relation(fields: [resolutionReasonId], references: [id])
  rejectReason      TicketRejectReason?     @relation(fields: [rejectReasonId], references: [id])

  activities  TicketActivity[]
  notes       TicketNote[]
  rating      TicketRating?
  attachments TicketAttachment[]

  @@index([targetDepartmentId, status])
  @@index([assignedEmployeeId])
  @@index([requestedById])
  @@map("internal_tickets")
}

model TicketNote {
  id          String                 @id @default(cuid())
  ticketId    String                 @map("ticket_id")
  authorId    String                 @map("author_id")
  content     String
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  author      User                   @relation("TicketNoteAuthor", fields: [authorId], references: [id])
  ticket      InternalTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketNoteAttachment[]

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_notes")
}

model TicketActivity {
  id        String         @id @default(cuid())
  ticketId  String         @map("ticket_id")
  actorId   String         @map("actor_id")
  action    String
  details   Json?
  createdAt DateTime       @default(now()) @map("created_at")
  actor     User           @relation("TicketActivityActor", fields: [actorId], references: [id])
  ticket    InternalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([actorId])
  @@map("ticket_activities")
}

model TicketAttachment {
  id           String               @id @default(cuid())
  ticketId     String               @map("ticket_id")
  uploadedById String?              @map("uploaded_by_id")
  storageKey   String               @unique @map("storage_key")
  fileName     String               @map("file_name")
  contentType  String               @map("content_type")
  sizeBytes    Int                  @map("size_bytes")
  scanStatus   AttachmentScanStatus @default(PENDING) @map("scan_status")
  createdAt    DateTime             @default(now()) @map("created_at")

  ticket     InternalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User?          @relation("TicketAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([scanStatus])
  @@map("ticket_attachments")
}

model TicketNoteAttachment {
  id           String               @id @default(cuid())
  noteId       String               @map("note_id")
  uploadedById String?              @map("uploaded_by_id")
  storageKey   String               @unique @map("storage_key")
  fileName     String               @map("file_name")
  contentType  String               @map("content_type")
  sizeBytes    Int                  @map("size_bytes")
  scanStatus   AttachmentScanStatus @default(PENDING) @map("scan_status")
  createdAt    DateTime             @default(now()) @map("created_at")

  note       TicketNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("TicketNoteAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([noteId])
  @@index([scanStatus])
  @@map("ticket_note_attachments")
}

model TicketRating {
  id         String         @id @default(cuid())
  ticketId   String         @unique @map("ticket_id")
  managerId  String         @map("manager_id")
  employeeId String         @map("employee_id")
  score      Int
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")
  employee   User           @relation("TicketRatingEmployee", fields: [employeeId], references: [id])
  manager    User           @relation("TicketRatingManager", fields: [managerId], references: [id])
  ticket     InternalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("ticket_ratings")
}

model StandardProblem {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  categoryId   String   @map("category_id")
  titleEn      String   @map("title_en")
  titleAr      String   @map("title_ar")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  category   Category   @relation(fields: [categoryId], references: [id])

  @@index([departmentId])
  @@index([categoryId])
  @@map("standard_problems")
}

model DepartmentComplaintTemplate {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  name         String
  description  String?
  schema       Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
