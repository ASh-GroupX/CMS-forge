generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  CR_OFFICER
  CR_MANAGER
  BRANCH_MANAGER
  ADMIN
  MGMT_READONLY
  CUSTOMER_PORTAL
}

enum ComplaintStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEW
  BRANCH_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  REJECTED
  COMPLETED
}

enum ComplaintTransitionAction {
  SUBMIT
  ACCEPT_INTAKE
  REJECT_AS_INVALID
  APPROVE_AND_ROUTE
  SEND_BACK
  ASSIGN_INVESTIGATION
  RESOLVE_DIRECTLY
  REJECT_AFTER_REVIEW
  ADD_INVESTIGATION_UPDATE
  RESOLVE
  REJECT_AFTER_INVESTIGATION
  CLOSE
  REJECT_RESOLUTION
  REOPEN
  ROUTE_AGAIN
  COMPLETE
  CUSTOMER_REJECT_RESOLUTION
  CUSTOMER_RESUBMIT
}

enum ComplaintTransitionRequestSource {
  STAFF_API
  CUSTOMER_PORTAL
  SYSTEM_JOB
  IMPORT
}

enum ComplaintSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ComplaintSource {
  STAFF
  PORTAL
  EMAIL
  PHONE
  DMS
}

enum DataSource {
  LOCAL
  MANUAL
  DMS
}

enum ComplaintType {
  COMPLAINT
  ACTION_REQUEST
  CALL_BACK_REQUEST
  SERVICE_VISIT_REQUEST
  FOLLOW_UP_REQUEST
  INFORMATION_REQUEST
  INQUIRY
  SUGGESTION
  FEEDBACK
}

enum SlaStage {
  INTAKE
  MANAGER_REVIEW
  BRANCH_REVIEW
  INVESTIGATION
  RESOLUTION
  CLOSURE
}

enum WorkingCalendarMode {
  CALENDAR_HOURS
  ALWAYS_ON
}

enum SlaEventType {
  DEADLINE_SET
  WARNING
  BREACH
  PAUSED
  RESUMED
  RECALCULATED
}

enum CommentVisibility {
  INTERNAL
  PUBLIC
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum SurveyStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum CompensationType {
  GIFT
  SERVICE_DISCOUNT
  REFUND_REQUEST
  REPLACEMENT
  GOODWILL
  OTHER
}

enum CompensationStatus {
  PROPOSED
  APPROVED
  REJECTED
  CANCELLED
}

enum PortalVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
}

enum BoardScope {
  TASKS
  TICKETS
}

enum TaskLinkEntityType {
  CUSTOMER
  VEHICLE
  COMPLAINT
  CASE
  DEAL
  EMPLOYEE
}

enum TaskParticipantRole {
  OWNER
  ASSIGNEE
  PARTICIPANT
  WATCHER
}

enum TaskVisibility {
  PARTICIPANTS
  BRANCH
  MANAGEMENT
}

enum TaskConfidentialityLevel {
  NORMAL
  CONFIDENTIAL
  RESTRICTED
}

enum CommunicationGroupVisibility {
  PERSONAL
  SHARED
}

enum CollaborationMentionSource {
  USER
  SYSTEM_ROLE
  SYSTEM_DEPARTMENT
  CUSTOM_GROUP
}

enum CollaborationRecordType {
  COMPLAINT
  TASK
}

enum DealStage {
  LEAD
  BOOKING
  PAYMENT
  FINANCE
  INSURANCE
  REGISTRATION
  PDI
  DELIVERY
  POST_DELIVERY
}

enum CaseType {
  CUSTOMER_COMPLAINT
  EMPLOYEE_GRIEVANCE
}

enum CaseConfidentialityLevel {
  NORMAL
  CONFIDENTIAL
}

enum CaseLifecycleStatus {
  DRAFT
  HR_REVIEW
  INVESTIGATION
  DECISION
  CLOSED
  APPEALED
}

enum CaseParticipantRole {
  OWNER
  PARTICIPANT
  ACCUSED
}

enum CapaActionStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum CaseLinkEntityType {
  CUSTOMER
  VEHICLE
  COMPLAINT
  DEAL
  EMPLOYEE
}

enum AuditEventType {
  AUTH
  USER_ADMIN
  COMPLAINT
  WORKFLOW
  COMMENT
  ATTACHMENT
  SLA
  NOTIFICATION
  REPORT
  CONFIG
  SECURITY
  TASK
}

model Branch {
  id                          String                       @id @default(cuid())
  code                        String                       @unique
  nameEn                      String                       @map("name_en")
  nameAr                      String                       @map("name_ar")
  timezone                    String                       @default("Asia/Riyadh")
  isActive                    Boolean                      @default(true) @map("is_active")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  users                       User[]
  departments                 Department[]
  complaints                  Complaint[]
  complaintReferenceSequences ComplaintReferenceSequence[]
  slaPolicies                 SlaPolicy[]
  auditLogs                   AuditLog[]
  deals                       Deal[]
  cases                       Case[]
  assignments                 Assignment[]                 @relation("AssignmentScopeBranch")
  Category                    Category[]

  @@map("branches")
}

model Department {
  complaintTemplates DepartmentComplaintTemplate[]

  internalTickets         InternalTicket[]         @relation("InternalTicketTargetDepartment")
  ticketWaitingReasons    TicketWaitingReason[]
  ticketResolutionReasons TicketResolutionReason[]
  ticketRejectReasons     TicketRejectReason[]
  standardProblems        StandardProblem[]
  ticketFormConfig        DepartmentTicketFormConfig?
  ticketCustomFields      DepartmentTicketCustomField[]

  id                String              @id @default(cuid())
  code              String              @unique
  nameEn            String              @map("name_en")
  nameAr            String              @map("name_ar")
  branchId          String?             @map("branch_id")
  isActive          Boolean             @default(true) @map("is_active")
  allowedSendToDepartmentIds      String[] @default([]) @map("allowed_send_to_department_ids")
  allowedReceiveFromDepartmentIds String[] @default([]) @map("allowed_receive_from_department_ids")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  branch            Branch?             @relation(fields: [branchId], references: [id])
  users             User[]
  complaints        Complaint[]
  slaPolicies       SlaPolicy[]
  capaActions       CapaAction[]
  tasks             Task[]
  taskRecipients    TaskDepartmentRecipient[]
  assignments       Assignment[]        @relation("AssignmentDepartment")
  assignmentHistory AssignmentHistory[] @relation("AssignmentHistoryDepartment")
  deals             Deal[]
  cases             Case[]
  Category          Category[]

  @@index([branchId])
  @@map("departments")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  nameEn      String           @map("name_en")
  nameAr      String           @map("name_ar")
  isActive    Boolean          @default(true) @map("is_active")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  nameEn    String           @map("name_en")
  nameAr    String           @map("name_ar")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  requestedTickets          InternalTicket[]       @relation("TicketRequestedBy")
  assignedInternalTickets   InternalTicket[]       @relation("TicketAssignedEmployee")
  requestedEmployeeTickets  InternalTicket[]       @relation("TicketRequestedEmployee")
  ticketNotes               TicketNote[]           @relation("TicketNoteAuthor")
  ticketActivities          TicketActivity[]       @relation("TicketActivityActor")
  managerTicketRatings      TicketRating[]         @relation("TicketRatingManager")
  employeeTicketRatings     TicketRating[]         @relation("TicketRatingEmployee")
  uploadedTicketAttachments TicketAttachment[]     @relation("TicketAttachmentUploadedBy")
  uploadedNoteAttachments   TicketNoteAttachment[] @relation("TicketNoteAttachmentUploadedBy")
  ticketRule                UserTicketRule?

  id                        String                     @id @default(cuid())
  email                     String?                    @unique
  username                  String?                    @unique
  phone                     String?                    @map("phone")
  viewMode                  String?                    @default("BOTH") @map("view_mode")
  allowedNavKeys            String[]                   @default([]) @map("allowed_nav_keys")
  nameEn                    String                     @map("name_en")
  nameAr                    String                     @map("name_ar")
  passwordHash              String?                    @map("password_hash")
  roleId                    String                     @map("role_id")
  branchId                  String?                    @map("branch_id")
  departmentId              String?                    @map("department_id")
  isActive                  Boolean                    @default(true) @map("is_active")
  lockedAt                  DateTime?                  @map("locked_at")
  lastLoginAt               DateTime?                  @map("last_login_at")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  role                      Role                       @relation(fields: [roleId], references: [id])
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  department                Department?                @relation(fields: [departmentId], references: [id])
  createdComplaints         Complaint[]                @relation("ComplaintCreatedBy")
  ownedComplaints           Complaint[]                @relation("ComplaintOwner")
  statusHistory             ComplaintStatusHistory[]
  comments                  Comment[]
  attachments               Attachment[]
  approvalsRequested        Approval[]                 @relation("ApprovalRequestedBy")
  approvalsDecided          Approval[]                 @relation("ApprovalDecidedBy")
  notifications             Notification[]             @relation("NotificationRecipient")
  surveys                   Survey[]
  compensationProposed      Compensation[]             @relation("CompensationProposedBy")
  compensationApproved      Compensation[]             @relation("CompensationApprovedBy")
  staffSessions             StaffSession[]
  passwordResetTokens       StaffPasswordResetToken[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  ownedTasks                Task[]                     @relation("TaskOwner")
  assignedTasks             Task[]                     @relation("TaskAssignee")
  taskNextActions           Task[]                     @relation("TaskNextActionWho")
  taskParticipants          TaskParticipant[]
  taskComments              TaskComment[]              @relation("TaskCommentAuthor")
  taskStatusHistory         TaskStatusHistory[]
  communicationGroups       CommunicationGroup[]       @relation("CommunicationGroupOwner")
  communicationGroupMembers CommunicationGroupMember[]
  complaintWatchers         ComplaintWatcher[]         @relation("ComplaintWatcherUser")
  complaintWatcherAdds      ComplaintWatcher[]         @relation("ComplaintWatcherAddedBy")
  complaintCommentMentions  ComplaintCommentMention[]
  taskCommentMentions       TaskCommentMention[]
  notificationDigestItems   NotificationDigestItem[]
  ownedDeals                Deal[]                     @relation("DealOwner")
  currentDealHandoffs       Deal[]                     @relation("DealCurrentHolder")
  ownedCases                Case[]                     @relation("CaseOwner")
  ownedCapaActions          CapaAction[]               @relation("CapaActionOwner")
  caseParticipants          CaseParticipant[]
  caseRestrictedNotes       CaseRestrictedNote[]       @relation("CaseRestrictedNoteAuthor")
  assignmentsReceived       Assignment[]               @relation("AssignmentAssignedUser")
  assignmentsMade           Assignment[]               @relation("AssignmentActor")
  assignmentHistoryReceived AssignmentHistory[]        @relation("AssignmentHistoryAssignedUser")
  assignmentHistoryMade     AssignmentHistory[]        @relation("AssignmentHistoryActor")
  complaintsAsBackup        Complaint[]                @relation("ComplaintBackupOfficer")
  complaintsAsCollaborator  Complaint[]                @relation("ComplaintCollaborator")

  @@index([roleId])
  @@index([branchId])
  @@index([departmentId])
  @@map("users")
}

model StaffSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model StaffPasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("staff_password_reset_tokens")
}

model Category {
  branchId         String?           @map("branch_id")
  departmentId     String?           @map("department_id")
  isExternal       Boolean           @default(true) @map("is_external")
  isInternal       Boolean           @default(false) @map("is_internal")
  branch           Branch?           @relation(fields: [branchId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  standardProblems StandardProblem[]
  internalTickets  InternalTicket[]

  id          String      @id @default(cuid())
  code        String      @unique
  nameEn      String      @map("name_en")
  nameAr      String      @map("name_ar")
  parentId    String?     @map("parent_id")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  complaints  Complaint[]
  slaPolicies SlaPolicy[]

  @@index([parentId])
  @@map("categories")
}

model Customer {
  id                     String                          @id @default(cuid())
  nameEn                 String                          @map("name_en")
  nameAr                 String                          @map("name_ar")
  phone                  String                          @unique
  email                  String?
  dmsCode                String?                         @map("dms_code")
  dataSource             DataSource                      @default(LOCAL) @map("data_source")
  createdAt              DateTime                        @default(now()) @map("created_at")
  updatedAt              DateTime                        @updatedAt @map("updated_at")
  vehicles               Vehicle[]
  complaints             Complaint[]
  surveys                Survey[]
  portalVerifications    PortalVerification[]
  portalSessions         PortalSession[]
  notificationPreference CustomerNotificationPreference?

  @@map("customers")
}

model Vehicle {
  id         String      @id @default(cuid())
  vin        String      @unique
  plate      String
  makeEn     String      @map("make_en")
  modelEn    String      @map("model_en")
  year       Int
  dataSource DataSource  @default(LOCAL) @map("data_source")
  customerId String?     @map("customer_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  customer   Customer?   @relation(fields: [customerId], references: [id])
  complaints Complaint[]

  @@index([customerId])
  @@map("vehicles")
}

model Complaint {
  rootCauseCategory String?                    @map("root_cause_category")
  salesAdvisorName String?                     @map("sales_advisor_name")
  odometer        Int?                         @map("odometer")
  lastServiceDate DateTime?                    @map("last_service_date")
  templateData    Json?                        @map("template_data")
  template        DepartmentComplaintTemplate? @relation(fields: [templateId], references: [id])

  templateId     String?  @map("template_id")
  channel        String? // Recovered missing fields
  customerType   String?  @map("customer_type")
  repeatCustomer Boolean? @map("repeat_customer")
  warrantyActive Boolean? @map("warranty_active")
  alternativeCarProvided Boolean @default(false) @map("alternative_car_provided")
  backupOfficerId        String?  @map("backup_officer_id")
  collaboratorId         String?  @map("collaborator_id")
  isJustified            Boolean? @map("is_justified")
  satisfactionStatus     String?  @map("satisfaction_status")
  investigationNotes     String?  @map("investigation_notes")
  investigatedAt         DateTime? @map("investigated_at")

  id                           String                   @id @default(cuid())
  referenceNumber              String                   @unique @map("reference_number")
  status                       ComplaintStatus          @default(DRAFT)
  type                         ComplaintType            @default(COMPLAINT)
  severity                     ComplaintSeverity        @default(MEDIUM)
  source                       ComplaintSource          @default(STAFF)
  customerDataSource           DataSource               @default(LOCAL) @map("customer_data_source")
  vehicleDataSource            DataSource?              @map("vehicle_data_source")
  manualCustomerFlag           Boolean                  @default(false) @map("manual_customer_flag")
  manualVehicleFlag            Boolean                  @default(false) @map("manual_vehicle_flag")
  vehicleRelated               Boolean                  @default(false) @map("vehicle_related")
  vehicleDataUnavailableReason String?                  @map("vehicle_data_unavailable_reason")
  subject                      String                   @default("General complaint")
  branchId                     String                   @map("branch_id")
  categoryId                   String                   @map("category_id")
  customerId                   String                   @map("customer_id")
  vehicleId                    String?                  @map("vehicle_id")
  createdById                  String?                  @map("created_by_id")
  ownerId                      String?                  @map("owner_id")
  departmentId                 String?                  @map("department_id")
  descriptionEn                String                   @map("description_en")
  descriptionAr                String?                  @map("description_ar")
  incidentAt                   DateTime?                @map("incident_at")
  firstResponseAt              DateTime?                @map("first_response_at")
  resolvedAt                   DateTime?                @map("resolved_at")
  closedAt                     DateTime?                @map("closed_at")
  version                      Int                      @default(1)
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  branch                       Branch                   @relation(fields: [branchId], references: [id])
  category                     Category                 @relation(fields: [categoryId], references: [id])
  customer                     Customer                 @relation(fields: [customerId], references: [id])
  vehicle                      Vehicle?                 @relation(fields: [vehicleId], references: [id])
  createdBy                    User?                    @relation("ComplaintCreatedBy", fields: [createdById], references: [id])
  owner                        User?                    @relation("ComplaintOwner", fields: [ownerId], references: [id])
  backupOfficer                User?                    @relation("ComplaintBackupOfficer", fields: [backupOfficerId], references: [id])
  collaborator                 User?                    @relation("ComplaintCollaborator", fields: [collaboratorId], references: [id])
  department                   Department?              @relation(fields: [departmentId], references: [id])
  statusHistory                ComplaintStatusHistory[]
  approvals                    Approval[]
  attachments                  Attachment[]
  comments                     Comment[]
  slaEvents                    SlaEvent[]
  notifications                Notification[]
  surveys                      Survey[]
  compensation                 Compensation[]
  portalVerifications          PortalVerification[]
  portalSessions               PortalSession[]
  relatedSources               ComplaintRelation[]      @relation("ComplaintRelationSource")
  relatedTargets               ComplaintRelation[]      @relation("ComplaintRelationTarget")
  watchers                     ComplaintWatcher[]

  @@index([status])
  @@index([branchId, status])
  @@index([severity])
  @@index([createdAt])
  @@index([ownerId])
  @@index([referenceNumber])
  @@map("complaints")
}

model ComplaintStatusHistory {
  id            String                            @id @default(cuid())
  complaintId   String                            @map("complaint_id")
  fromStatus    ComplaintStatus?                  @map("from_status")
  toStatus      ComplaintStatus                   @map("to_status")
  action        ComplaintTransitionAction?
  actorId       String?                           @map("actor_id")
  actorRole     String?                           @map("actor_role")
  requestSource ComplaintTransitionRequestSource? @map("request_source")
  reason        String?
  correlationId String?                           @map("correlation_id")
  createdAt     DateTime                          @default(now()) @map("created_at")
  complaint     Complaint                         @relation(fields: [complaintId], references: [id])
  actor         User?                             @relation(fields: [actorId], references: [id])

  @@index([complaintId, createdAt])
  @@index([actorId])
  @@map("complaint_status_history")
}

model ComplaintReferenceSequence {
  branchId     String   @map("branch_id")
  year         Int
  nextSequence Int      @default(1) @map("next_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")
  branch       Branch   @relation(fields: [branchId], references: [id])

  @@id([branchId, year])
  @@map("complaint_reference_sequences")
}

model ComplaintRelation {
  id                String    @id @default(cuid())
  sourceComplaintId String    @map("source_complaint_id")
  targetComplaintId String    @map("target_complaint_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  sourceComplaint   Complaint @relation("ComplaintRelationSource", fields: [sourceComplaintId], references: [id], onDelete: Cascade)
  targetComplaint   Complaint @relation("ComplaintRelationTarget", fields: [targetComplaintId], references: [id], onDelete: Cascade)

  @@unique([sourceComplaintId, targetComplaintId])
  @@index([targetComplaintId])
  @@map("complaint_relations")
}

model Approval {
  id            String         @id @default(cuid())
  complaintId   String         @map("complaint_id")
  requestedById String?        @map("requested_by_id")
  decidedById   String?        @map("decided_by_id")
  status        ApprovalStatus @default(PENDING)
  comment       String?
  requestedAt   DateTime       @default(now()) @map("requested_at")
  decidedAt     DateTime?      @map("decided_at")
  complaint     Complaint      @relation(fields: [complaintId], references: [id])
  requestedBy   User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([complaintId])
  @@index([status])
  @@map("approvals")
}

model Attachment {
  id              String               @id @default(cuid())
  complaintId     String               @map("complaint_id")
  uploadedById    String?              @map("uploaded_by_id")
  storageKey      String               @unique @map("storage_key")
  fileName        String               @map("file_name")
  contentType     String               @map("content_type")
  sizeBytes       Int                  @map("size_bytes")
  scanStatus      AttachmentScanStatus @default(PENDING) @map("scan_status")
  customerVisible Boolean              @default(false) @map("customer_visible")
  createdAt       DateTime             @default(now()) @map("created_at")
  complaint       Complaint            @relation(fields: [complaintId], references: [id])
  uploadedBy      User?                @relation(fields: [uploadedById], references: [id])

  @@index([complaintId])
  @@index([scanStatus])
  @@map("attachments")
}

model Comment {
  id          String                    @id @default(cuid())
  complaintId String                    @map("complaint_id")
  authorId    String?                   @map("author_id")
  body        String
  visibility  CommentVisibility         @default(INTERNAL)
  editedAt    DateTime?                 @map("edited_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  complaint   Complaint                 @relation(fields: [complaintId], references: [id])
  author      User?                     @relation(fields: [authorId], references: [id])
  mentions    ComplaintCommentMention[]

  @@index([complaintId, createdAt])
  @@index([visibility])
  @@map("comments")
}

model ComplaintWatcher {
  id          String    @id @default(cuid())
  complaintId String    @map("complaint_id")
  userId      String    @map("user_id")
  addedById   String    @map("added_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation("ComplaintWatcherUser", fields: [userId], references: [id])
  addedBy     User      @relation("ComplaintWatcherAddedBy", fields: [addedById], references: [id])

  @@unique([complaintId, userId])
  @@index([userId])
  @@map("complaint_watchers")
}

model ComplaintCommentMention {
  id              String                     @id @default(cuid())
  commentId       String                     @map("comment_id")
  recipientUserId String                     @map("recipient_user_id")
  source          CollaborationMentionSource
  sourceId        String?                    @map("source_id")
  sourceLabel     String                     @map("source_label")
  createdAt       DateTime                   @default(now()) @map("created_at")
  comment         Comment                    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  recipientUser   User                       @relation(fields: [recipientUserId], references: [id])

  @@unique([commentId, recipientUserId])
  @@index([recipientUserId])
  @@map("complaint_comment_mentions")
}

model SlaPolicy {
  id                                 String              @id @default(cuid())
  severity                           ComplaintSeverity
  stage                              SlaStage
  branchId                           String?             @map("branch_id")
  departmentId                       String?             @map("department_id")
  categoryId                         String?             @map("category_id")
